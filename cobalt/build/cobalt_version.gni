# Exposes the Cobalt version defined in //cobalt/version.h to GN.
#
# read_file() registers //cobalt/version.h as an input of the build graph, so
# GN automatically regenerates when the version changes.

_cobalt_version_defines =
    filter_include(read_file("//cobalt/version.h", "list lines"),
                   [ "#define COBALT_VERSION \"*\"" ])
assert(_cobalt_version_defines != [],
       "COBALT_VERSION is not defined in //cobalt/version.h")

# The Cobalt version string, e.g. "27.lts.10" or "27.master.0".
cobalt_version = string_replace(string_replace(_cobalt_version_defines[0],
                                               "#define COBALT_VERSION \"",
                                               "",
                                               1),
                                "\"",
                                "",
                                1)

# True if |cobalt_version| is an LTS release version, e.g. "27.lts.10", as
# opposed to a development version such as "27.master.0". Only LTS versions
# have a corresponding Evergreen version.
cobalt_is_lts_version =
    string_replace(cobalt_version, ".lts.", "", 1) != cobalt_version
