# Starboard's SbPlayer exposed to WebAssembly guests; Blink exposes it as
# h5vccWasmImports.
static_library("starboard_wasm") {
  sources = [
    "event_queue.cc",
    "event_queue.h",
    "guest_memory.cc",
    "guest_memory.h",
    "wasm_player_host.cc",
    "wasm_player_host.h",
    "wasm_starboard_abi.h",
  ]
  public_deps = [
    "//base",
    "//cobalt/media/service/mojom",
    "//mojo/public/cpp/bindings",
    "//starboard:starboard_group",
    "//ui/gfx/geometry",
    "//v8",
  ]
  deps = [
    ":surface_video_size",
    "//media",
  ]
}

# Shared with the surface's <video> element in content/renderer.
static_library("surface_video_size") {
  sources = [
    "surface_video_size.cc",
    "surface_video_size.h",
  ]
  public_deps = [
    "//base",
    "//ui/gfx/geometry",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "event_queue_unittest.cc",
    "guest_memory_unittest.cc",
    "surface_video_size_unittest.cc",
    "wasm_player_host_unittest.cc",
  ]
  deps = [
    ":starboard_wasm",
    ":surface_video_size",
    "//base/test:test_support",
    "//gin:gin_test",
    "//media",
    "//media:test_support",
    "//testing/gmock",
    "//testing/gtest",
  ]
}
