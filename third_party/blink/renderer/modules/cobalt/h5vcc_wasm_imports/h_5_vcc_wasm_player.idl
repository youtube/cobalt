// SbPlayer: decodes and renders samples demuxed by the Wasm module. Events
// arrive through H5vccWasmSystem.pollEvents(). See h_5_vcc_wasm_imports.idl.
[
    Exposed=(Window,DedicatedWorker),
    SecureContext
]
interface H5vccWasmPlayer {
  // Creates a player rendering into `surface` from audio and video config
  // records (either may be empty). Returns a player handle, or 0.
  [CallWith=Isolate, NoAllocDirectCall]
  unsigned long create(unsigned long audioConfig,
                       unsigned long audioConfigLength,
                       unsigned long videoConfig,
                       unsigned long videoConfigLength,
                       unsigned long surface,
                       unsigned long flags);
  [NoAllocDirectCall] undefined destroy(unsigned long player);

  // Events the player reports after the seek carry `ticket`.
  [NoAllocDirectCall]
  undefined seek(unsigned long player,
                 unrestricted double positionUs,
                 unsigned long ticket);

  // Writes `count` samples of `track`: their payload bytes, one sample info
  // record each, and an optional config record for a configuration change.
  // Returns how many samples were accepted.
  [CallWith=Isolate, NoAllocDirectCall]
  unsigned long writeSamples(unsigned long player,
                             unsigned long track,
                             unsigned long bytes,
                             unsigned long bytesLength,
                             unsigned long infos,
                             unsigned long count,
                             unsigned long config,
                             unsigned long configLength);
  [NoAllocDirectCall]
  undefined writeEos(unsigned long player, unsigned long track);

  // Rates and volumes are in thousandths.
  [NoAllocDirectCall]
  undefined setRate(unsigned long player, long rateMilli);
  [NoAllocDirectCall]
  undefined setVolume(unsigned long player, long volumeMilli);

  // Writes a player info record; returns the number of bytes written.
  [CallWith=Isolate, NoAllocDirectCall]
  unsigned long getInfo(unsigned long player,
                        unsigned long info,
                        unsigned long infoLength);

  // Writes a media capabilities record for a MIME type; returns the number
  // of bytes written.
  [CallWith=Isolate, NoAllocDirectCall]
  unsigned long mediaCaps(unsigned long mime,
                          unsigned long mimeLength,
                          unsigned long caps,
                          unsigned long capsLength);
};
