{
    "CobaltCCImageCacheLimitItemsStudy": [
        {
            "platforms": [
                "android"
            ],
            "experiments": [
                {
                    "name": "Experiment50Items",
                    "params": {
                        "cc_image_cache_limit_items": "50"
                    },
                    "enable_features": [
                        "CobaltCCImageCacheLimitItems"
                    ]
                }
            ]
        }
    ],
    "CobaltChromiumBackportStudy": [
        {
            "platforms": [
                "android"
            ],
            "experiments": [
                {
                    "name": "EnableAllChromiumBackports",
                    "enable_features": [
                        "DeferImplInvalidation",
                        "FastPathNoRaster",
                        "ImageLoadingPrioritizationFix",
                        "OptimizeHTMLElementUrls",
                        "PruneOldTransferCacheEntries",
                        "RemoveCancelledScriptedIdleTasks",
                        "SendExplicitDecodeRequestsImmediately"
                    ]
                }
            ]
        }
    ],
    "CobaltDisableDecoderBufferAllocatorLaunch": [
        {
            "platforms": [
                "android"
            ],
            "experiments": [
                {
                    "name": "Treatment",
                    "enable_features": [
