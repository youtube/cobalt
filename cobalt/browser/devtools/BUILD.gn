import("//cobalt/build/configs/cobalt.gni")

if (!cobalt_is_release_build) {
  source_set("devtools") {
    sources = [
      "cobalt_devtools_manager_delegate.cc",
      "cobalt_devtools_manager_delegate.h",
    ]

    public_deps = [
      "//base",
      "//cobalt/browser/logging",
      "//cobalt/shell:cobalt_shell_lib",
      "//content/public/browser",
    ]

    deps = [
      "//cobalt/browser:switches",
      "//third_party/inspector_protocol:crdtp",
    ]
  }

  source_set("unit_tests") {
    testonly = true

    sources = [ "cobalt_devtools_manager_delegate_unittest.cc" ]

    deps = [
      ":devtools",
      "//base",
      "//base/test:test_support",
      "//cobalt/browser/logging",
      "//content/public/browser",
      "//testing/gtest",
      "//third_party/inspector_protocol:crdtp",
    ]
  }
}
