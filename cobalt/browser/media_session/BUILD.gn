# Bridges content::MediaSession to the Starboard MediaSession extension. Only
# meaningful on Starboard builds; the Android TV (non-Starboard) build uses
# CobaltMediaSession.java instead.
assert(is_starboard)

source_set("media_session") {
  sources = [
    "media_session_extension_bridge.cc",
    "media_session_extension_bridge.h",
  ]

  public_deps = [
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//services/media_session/public/cpp",
    "//services/media_session/public/mojom",
    "//starboard:starboard_headers_only",
  ]

  deps = [
    "//base",
    "//starboard:starboard_group",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "media_session_extension_bridge_unittest.cc" ]
  deps = [
    ":media_session",
    "//base",
    "//base/test:test_support",
    "//content/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/gfx/geometry",
    "//url",
  ]
}
