// Non standard interface used for Cobalt only: multi-SourceBuffer switching.
// A standby SourceBuffer buffers media that plays later, and changeTo() hands
// playback over to it. The H5VCC setting
// `Media.EnableMultiSourceBufferSwitching` exposes these.

[
    Exposed=Window,
    ImplementedAs=MediaSourceChangeTo
] partial interface MediaSource {
    [
        RaisesException,
        RuntimeEnabled=MediaSourceChangeTo
    ] SourceBuffer addSourceBuffer(DOMString type, SourceBufferInit init);
    [
        CallWith=ScriptState,
        RaisesException,
        RuntimeEnabled=MediaSourceChangeTo
    ] Promise<undefined> changeTo(sequence<SourceBuffer> sourceBuffers);
};
