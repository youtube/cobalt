// Cobalt-specific event type names. These are kept separate from Chromium's
// third_party/blink/renderer/core/events/event_type_names.json5 so that
// Cobalt additions do not conflict with upstream changes during rebases.
//
// Generates event_type_cobalt_names.{h,cc}, exposing the names in the
// blink::event_type_names namespace (e.g. event_type_names::kDeeplink).
{
  metadata: {
    namespace: "event_type_names",
    suffix: "Cobalt",
    export: "MODULES_EXPORT",
  },

  data: [
    "deeplink",
    "hide",
    "lowmemory",
    "metrics",
    "texttospeechchange",
  ],
}
