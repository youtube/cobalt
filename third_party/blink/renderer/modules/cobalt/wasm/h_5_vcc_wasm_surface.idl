// Surfaces bind players to <video> elements. A <video> in the top-level
// document whose src is a blob: URL ending in `#sb-surface=<token>` punches a
// hole where the element is, and the players created on that surface follow
// it. The element is display-only: it doesn't play, and its currentTime stays
// 0. Use one element per surface; with several, the most recently drawn wins.
// When the element goes away, the players keep their last position, so to
// replace it, give the new element the same token (it may flicker briefly).
// See h_5_vcc_wasm_imports.idl.
[
    Exposed=(Window,DedicatedWorker),
    RuntimeEnabled=H5vccWasmImports,
    SecureContext
]
interface H5vccWasmSurface {
  // Returns a surface handle, never 0.
  [NoAllocDirectCall] unsigned long create();
  [NoAllocDirectCall] undefined destroy(unsigned long surface);

  // Returns "" for unknown surfaces. The token is an overlay plane id.
  DOMString token(unsigned long surface);
};
