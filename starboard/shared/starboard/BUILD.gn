static_library("feature_list") {
  sources = [
    "feature_list.cc",
    "feature_list.h",
    "features.cc",
    "features.h",
    "features_extension.cc",
    "features_extension.h",
  ]

  # features.h includes feature_config.h.
  public_deps = [ "//starboard/extension:feature_config_header" ]
  deps = [ "//starboard/common" ]
}

# Initializes the Starboard feature list with the defaults from
# //starboard/extension/feature_config.h, for test and benchmark binaries that
# run without the browser layer that normally provides the feature values.
source_set("features_test_util") {
  testonly = true

  sources = [
    "features_test_util.cc",
    "features_test_util.h",
  ]

  public_deps = [ ":feature_list" ]
}

source_set("starboard_test") {
  testonly = true

  sources = [ "feature_list_test.cc" ]

  deps = [
    ":feature_list",
    "//starboard/common",
    "//testing/gtest",
  ]
}
