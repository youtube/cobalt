// Non standard interface used for Cobalt only: multi-SourceBuffer switching.
// A standby SourceBuffer buffers media that plays later, and changeTo() hands
// playback over to it. The H5VCC setting
// `Media.EnableMultiSourceBufferSwitching` exposes these.

[
    Exposed=Window,
    ImplementedAs=MediaSourceChangeTo
] partial interface MediaSource {
    // Like addSourceBuffer(), but the SourceBuffer is standby: its tracks stay
    // disabled, and it takes no part in playback (buffered ranges, seeks,
    // activeSourceBuffers) until changeTo() selects it. Unlike
    // addSourceBuffer(), it also works once the media element has metadata.
    [
        RaisesException,
        RuntimeEnabled=MediaSourceChangeTo
    ] SourceBuffer addStandbySourceBuffer(DOMString type);
    // Hands playback over to `sourceBuffers`, one per media type that plays,
    // and seeks to where their buffered media starts. Throws, and changes
    // nothing, if it can't: an InvalidStateError if the MediaSource is closed,
    // a SourceBuffer isn't in sourceBuffers or has no buffered media, or the
    // media element has no metadata yet; a TypeError if `sourceBuffers` is
    // empty; a NotSupportedError if the switch isn't possible (see
    // canChangeTo()). If readyState is "ended", a successful switch makes it
    // "open", as appendBuffer() does. The SourceBuffers switched away from
    // become read-only, and can be removed.
    [
        RaisesException,
        RuntimeEnabled=MediaSourceChangeTo
    ] undefined changeTo(sequence<SourceBuffer> sourceBuffers);
    // Whether changeTo() can switch from a SourceBuffer of type `currentType`
    // to one of type `nextType`. Each type names exactly one codec. A switch
    // that changes the codec needs the platform's support
    // (SbMediaCanChangeType()), so a page checks before it buffers the media
    // to switch to.
    [
        RuntimeEnabled=MediaSourceChangeTo
    ] static boolean canChangeTo(DOMString currentType, DOMString nextType);
};
