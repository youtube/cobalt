# Shared with content/renderer (the <video> hole player), so it depends only
# on //base.
static_library("surface_registry") {
  sources = [
    "surface_registry.cc",
    "surface_registry.h",
  ]
  deps = [ "//base" ]
}

static_library("player") {
  sources = [
    "player_abi.h",
    "player_host.cc",
    "player_host.h",
    "player_module.cc",
    "player_module.h",
  ]
  public_deps = [ ":surface_registry" ]
  deps = [
    "//base",
    "//cobalt/starboard_wasm/core",
    "//starboard:starboard_group",
    "//starboard/common",
  ]
}
