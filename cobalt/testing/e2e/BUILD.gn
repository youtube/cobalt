import("//testing/test.gni")

if (is_cobalt_hermetic_build) {
  _cobalt = "cobalt_loader"
} else {
  _cobalt = "cobalt"
}

_data = [
  "conftest.py",
  "//.vpython3",
  "//cobalt/tools/cdp_js_helper.py",
]

script_test("lifecycle_e2e_test") {
  script = "lifecycle_e2e_test.py"
  args = [ "--cobalt=@WrappedPath(./$_cobalt)" ]
  data = _data
  data_deps = [ "//cobalt:$_cobalt" ]
}

if (!is_cobalt_hermetic_build) {
  script_test("chromedriver_smoke_test") {
    script = "chromedriver_smoke_test.py"
    args = [
      "--cobalt=@WrappedPath(./cobalt)",
      "--chromedriver=@WrappedPath(./chromedriver)",
    ]
    data = _data
    data_deps = [
      "//chrome/test/chromedriver:chromedriver_server",
      "//cobalt",
    ]
  }
}
