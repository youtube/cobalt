# These targets audit that the Starboard (partner) toolchain supports the C++
# standards required by the software requirements. They are intended to be
# built with $starboard_toolchain as compile-only dependencies of NPLB (see
# //starboard/nplb:nplb), and are never linked into or run by any test.

config("no_unused") {
  cflags = [
    "-Wno-unused-variable",
    "-Wno-unused-function",
    "-Wno-unused-const-variable",
    "-Wno-unreachable-code-break",
  ]
}

if (sb_enable_cpp17_audit) {
  static_library("cpp17_supported") {
    sources = [ "cpp17_support.cc" ]
    configs += [
      "//starboard/build/config:starboard",
      "//starboard/build/config/sabi",
      ":no_unused",
    ]
    deps = [
      ":cpp17_supported_config_shim",
      "//starboard:starboard_group",
    ]
  }

  # We do this to ensure the -std=c++17 flag is added after any other -std flag
  # so it overrides any other one.
  group("cpp17_supported_config_shim") {
    public_configs = [ ":cpp17_supported_config" ]
  }

  config("cpp17_supported_config") {
    cflags_cc = [ "-std=c++17" ]
  }
}

if (sb_enable_cpp20_audit) {
  static_library("cpp20_supported") {
    sources = [ "cpp20_support.cc" ]
    configs += [ ":no_unused" ]
    deps = [
      ":cpp20_supported_config_shim",
      "//starboard:starboard_group",
    ]
  }

  # We do this to ensure the -std=c++20 flag is added after any other -std flag
  # so it overrides any other one.
  group("cpp20_supported_config_shim") {
    public_configs = [ ":cpp20_supported_config" ]
  }

  config("cpp20_supported_config") {
    if (current_toolchain == default_toolchain) {
      configs = [ "//starboard/build/config:cpp20_supported_config" ]
    } else {
      # Partner toolchains commonly default to C++17 (i.e. use_cxx17 = true), so
      # explicitly request C++20 to audit the toolchain's C++20 support.
      cflags_cc = [ "-std=c++20" ]
    }
  }
}
