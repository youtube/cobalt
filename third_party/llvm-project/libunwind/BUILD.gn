common_sources = [
  "src/AddressSpace.hpp",
  "src/CompactUnwinder.hpp",
  "src/DwarfInstructions.hpp",
  "src/DwarfParser.hpp",
  "src/EHHeaderParser.hpp",
  "src/FrameHeaderCache.hpp",
  "src/RWMutex.hpp",
  "src/Registers.hpp",
  "src/Unwind-EHABI.cpp",
  "src/Unwind-EHABI.h",
  "src/Unwind-seh.cpp",
  "src/Unwind-sjlj.c",
  "src/UnwindCursor.hpp",
  "src/UnwindLevel1-gcc-ext.c",
  "src/UnwindLevel1.c",
  "src/UnwindRegistersRestore.S",
  "src/UnwindRegistersSave.S",
  "src/assembly.h",
  "src/cet_unwind.h",
  "src/config.h",
  "src/dwarf2.h",
  "src/libunwind.cpp",
  "src/libunwind_ext.h",
]
if (is_apple) {
  common_sources += [ "src/Unwind_AppleExtras.cpp" ]
}

common_removed_configs = [
  "//build/config/compiler:chromium_code",
  "//build/config/coverage:default_coverage",
  "//build/config/compiler:default_optimization",
]
common_added_configs = [
  "//build/config/compiler:no_chromium_code",
  "//build/config/compiler:optimize_speed",
]

config("common_unwind_config") {
  configs = [ "//buildtools/third_party/libunwind:libunwind_config" ]
  include_dirs = [ "include" ]

  # Hide the unwinder, so that the library that links it calls this unwinder
  # rather than one the platform has already loaded.
  defines = [ "_LIBUNWIND_HIDE_SYMBOLS" ]
}

config("unwind_config") {
  configs = [ ":common_unwind_config" ]

  defines = [
    "LIBUNWIND_PRINT_APIS",
    "LIBUNWIND_PRINT_DWARF",
    "LIBUNWIND_PRINT_UNWINDING",
  ]
  include_dirs = [ "//third_party/llvm-project/compiler-rt/include" ]
}

static_library("unwind") {
  sources = common_sources

  configs -= common_removed_configs
  configs += common_added_configs
  configs += [ ":unwind_config" ]

  deps = [
    "//starboard/common",
    "//third_party/musl:c",
  ]
}

config("unwind_starboard_config") {
  configs = [
    ":common_unwind_config",
    "//starboard/build/config:starboard_implementation",
  ]

  defines = [ "NDEBUG" ]
}

static_library("unwind_starboard") {
  sources = common_sources

  configs -= common_removed_configs
  configs += common_added_configs
  configs += [ ":unwind_starboard_config" ]

  public_deps = [
    "//starboard/common",
    "//starboard/elf_loader:evergreen_info",
  ]
}
