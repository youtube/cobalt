// Non-standard interface used for Cobalt only.
// Emits one PerformanceEntry per presented compositor frame.
// Note: Drops are detectable via frameToken gaps or presentationTime deltas;
// no synthetic entries are generated for skipped BeginFrames.
[Exposed=Window, RuntimeEnabled=CobaltFrameTiming]
interface CobaltFrameTiming : PerformanceEntry {
    readonly attribute unsigned long frameToken;
    readonly attribute DOMHighResTimeStamp presentationTime;

    // --- Main thread (null for compositor-only frames, e.g. CSS transform anims)
    readonly attribute double? animateDuration;
    readonly attribute double? styleDuration;
    readonly attribute double? layoutDuration;
    readonly attribute double? prepaintDuration;
    readonly attribute double? paintDuration;
    readonly attribute double? compositeCommitDuration;
    readonly attribute double? commitDuration;

    // --- Compositor / viz / GL (always present)
    readonly attribute double framePrepDuration;
    readonly attribute double drawDuration;
    readonly attribute double swapDuration;
    readonly attribute double? paintDamagePercentage;

    [CallWith=ScriptState, ImplementedAs=toJSONForBinding] object toJSON();
};
