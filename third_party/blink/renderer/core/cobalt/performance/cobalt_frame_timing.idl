// Non-standard interface used for Cobalt only.
// One record per presented compositor frame, delivered via
//   new PerformanceObserver(cb).observe({type: 'cobalt-frame'}).
// Note: Drops are detectable via frameToken gaps or presentationTime deltas;
// no synthetic entries are generated for skipped BeginFrames.
// Entries are delivered to the local root frame's window only (not to
// same-process iframes). The main-thread fields require the threaded
// compositor (ProxyMain); with a single-threaded compositor every entry is
// compositor-only.
[Exposed=Window, RuntimeEnabled=CobaltFrameTiming]
interface CobaltFrameTiming : PerformanceEntry {
    readonly attribute unsigned long frameToken;
    readonly attribute DOMHighResTimeStamp presentationTime;

    // --- Main thread 5 representative UMAs (null for compositor-only frames, e.g. CSS transform anims)
    readonly attribute DOMHighResTimeStamp? animateDuration;
    readonly attribute DOMHighResTimeStamp? styleDuration;
    readonly attribute DOMHighResTimeStamp? layoutDuration;
    readonly attribute DOMHighResTimeStamp? prepaintDuration;
    readonly attribute DOMHighResTimeStamp? paintDuration;

    // --- Compositor & EGL timings (always present)
    // framePrepDuration: previous swap_end -> this swap_start. Everything
    //   between consecutive swaps that is not the swap itself (main + cc +
    //   viz), *including idle time* when no frame was being produced; filter
    //   by cadence when measuring steady-state animation.
    // drawDuration: viz Display draw_start -> swap_start (SkiaRenderer /
    //   GPU-thread draw of the aggregated frame).
    // swapDuration: swap_start -> swap_end (eglSwapBuffers).
    readonly attribute DOMHighResTimeStamp framePrepDuration;
    readonly attribute DOMHighResTimeStamp drawDuration;
    readonly attribute DOMHighResTimeStamp swapDuration;

    // --- viz / GPU breakdown (null when viz did not report a timestamp).
    // receiveToDrawDuration: viz received this CompositorFrame -> viz Display
    //   draw start. When all are non-null, the remaining four sum to
    //   drawDuration:
    // vizDrawDuration: draw start -> draw posted to the GPU thread (viz CPU).
    // gpuDependencyWaitDuration: posted -> GPU-thread dependencies (raster,
    //   image uploads) satisfied; null if not reported (then folded into
    //   gpuQueueDuration).
    // gpuQueueDuration: ready -> GPU thread started the draw.
    // gpuDrawDuration: GPU thread started the draw -> swap start.
    readonly attribute DOMHighResTimeStamp? receiveToDrawDuration;
    readonly attribute DOMHighResTimeStamp? vizDrawDuration;
    readonly attribute DOMHighResTimeStamp? gpuDependencyWaitDuration;
    readonly attribute DOMHighResTimeStamp? gpuQueueDuration;
    readonly attribute DOMHighResTimeStamp? gpuDrawDuration;

    // --- Main-thread input path (null for compositor-only frames). The two
    // stages are consecutive and do not overlap.
    // mainFrameQueueDuration: VSync frame time -> BeginMainFrame task started
    //   on the main thread (cc scheduling + waiting behind other main-thread
    //   tasks such as keydown handlers and JS).
    // handleInputEventsDuration: rAF-aligned input dispatch at the start of
    //   this frame; 0 when there was none.
    readonly attribute DOMHighResTimeStamp? mainFrameQueueDuration;
    readonly attribute DOMHighResTimeStamp? handleInputEventsDuration;

    // Blink's bindings do not support [Default] toJSON, and a PerformanceEntry
    // subclass has to be an interface (not a dictionary), so toJSON follows
    // the same pattern as the other PerformanceEntry types.
    [CallWith=ScriptState, ImplementedAs=toJSONForBinding] object toJSON();
};
