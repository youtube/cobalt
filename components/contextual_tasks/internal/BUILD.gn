source_set("internal") {
  visibility = [
    ":*",
    "//chrome/browser/contextual_tasks:*",
    "//ios/chrome/browser/cobrowse/model:factory",
  ]

  sources = [
    "ai_thread_sync_bridge.cc",
    "ai_thread_sync_bridge.h",
    "composite_context_decorator.cc",
    "composite_context_decorator.h",
    "contextual_tasks_service_impl.cc",
    "contextual_tasks_service_impl.h",
    "conversions.cc",
    "conversions.h",
    "fallback_title_context_decorator.cc",
    "fallback_title_context_decorator.h",
    "favicon_context_decorator.cc",
    "favicon_context_decorator.h",
    "gemini_thread_sync_bridge.cc",
    "gemini_thread_sync_bridge.h",
    "history_context_decorator.cc",
    "history_context_decorator.h",
    "submitted_context_decorator.cc",
    "submitted_context_decorator.h",
    "token_based_context_decorator.cc",
    "token_based_context_decorator.h",
    "uploaded_context_decorator.cc",
    "uploaded_context_decorator.h",
  ]

  deps = [
    "//base",
    "//components/contextual_search:public",
    "//components/contextual_tasks/internal/proto",
    "//components/contextual_tasks/public",
    "//components/favicon/core",
    "//components/favicon_base",
    "//components/history/core/browser",
    "//components/keyed_service/core",
    "//components/omnibox/browser",
    "//components/omnibox/common",
    "//components/prefs",
    "//components/sessions:session_id",
    "//components/signin/public/identity_manager",
    "//components/sync/model",
    "//components/url_formatter",
    "//net",
    "//ui/gfx",
    "//url",
  ]

  if (is_cobalt) {
    # TODO(b/561957092): remove this at the 145.7577 roll, where
    # https://crrev.com/c/7234178 moves account_utils to public. Cobalt sets
    # build_with_tflite_lib false, which drops the re2 re-export upstream
    # reaches through omnibox.
    deps += [ "//third_party/re2" ]
  }
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "ai_thread_sync_bridge_unittest.cc",
    "composite_context_decorator_unittest.cc",
    "contextual_tasks_service_impl_unittest.cc",
    "conversions_unittest.cc",
    "fallback_title_context_decorator_unittest.cc",
    "favicon_context_decorator_unittest.cc",
    "gemini_thread_sync_bridge_unittest.cc",
    "history_context_decorator_unittest.cc",
    "submitted_context_decorator_unittest.cc",
    "uploaded_context_decorator_unittest.cc",
  ]

  deps = [
    ":internal",
    "//base",
    "//base/test:test_support",
    "//components/contextual_search:impl",
    "//components/contextual_search:prefs",
    "//components/contextual_search:public",
    "//components/contextual_search:test_support",
    "//components/contextual_tasks/public",
    "//components/favicon/core/test:test_support",
    "//components/history/core/browser",
    "//components/omnibox/browser",
    "//components/prefs:test_support",
    "//components/sessions:session_id",
    "//components/signin/public/identity_manager:test_support",
    "//components/sync:test_support",
    "//components/sync/model",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/gfx:test_support",
    "//url",
  ]

  visibility = [ "//components/contextual_tasks:unit_tests" ]
}
