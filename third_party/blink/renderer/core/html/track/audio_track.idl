// https://html.spec.whatwg.org/C/#audiotrack

// Cobalt: CobaltAudioVideoTracks is on whenever AudioVideoTracks is, and is
// also enabled by the H5VCC setting `Media.EnableMultiSourceBufferSwitching`.
[
    RuntimeEnabled=CobaltAudioVideoTracks,
    Exposed=Window
] interface AudioTrack {
  readonly attribute DOMString id;
  readonly attribute DOMString kind;
  readonly attribute DOMString label;
  readonly attribute DOMString language;
  attribute boolean enabled;
};
