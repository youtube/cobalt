<!--

This file describes the enumerations referenced by entries in histograms.xml for
this directory.

For best practices on writing enumerations descriptions, see
https://chromium.googlesource.com/chromium/src.git/+/HEAD/tools/metrics/histograms/README.md#Enum-Histograms
-->

<histogram-configuration>

<enums>

<enum name="Android.MemoryPressureNotification">
  <int value="0" label="Unknown onTrimMemory() level"/>
  <int value="1" label="TRIM_MEMORY_COMPLETE"/>
  <int value="2" label="TRIM_MEMORY_MODERATE"/>
  <int value="3" label="TRIM_MEMORY_BACKGROUND"/>
  <int value="4" label="TRIM_MEMORY_UI_HIDDEN"/>
  <int value="5" label="TRIM_MEMORY_RUNNING_CRITICAL"/>
  <int value="6" label="TRIM_MEMORY_RUNNING_LOW"/>
  <int value="7" label="TRIM_MEMORY_RUNNING_MODERATE"/>
  <int value="8" label="onLowMemory()"/>
</enum>

<enum name="AndroidDecoderFramework">
  <int value="0" label="Unknown"/>
  <int value="1" label="OpenMAX (OMX)"/>
  <int value="2" label="Codec2 (C2)"/>
</enum>

<enum name="BooleanHung">
  <int value="0" label="Is not hung"/>
  <int value="1" label="Is hung"/>
</enum>

<enum name="CobaltSplashScreenSwitchTrigger">
  <int value="0" label="Minimum splash screen duration elapsed"/>
  <int value="1" label="Splash screen closed itself"/>
  <int value="2" label="Main WebContents finished loading"/>
</enum>

<enum name="CobaltStabilityPmaFileAction">
  <int value="0" label="Merged and deleted"/>
  <int value="1" label="Already marked deleted (skipped)"/>
  <int value="2" label="Corrupt or unacceptable (deleted)"/>
  <int value="3" label="Invalid file name or PID (deleted)"/>
</enum>

<enum name="CobaltStartupMilestone">
  <int value="1" label="JavaActivityCreated"/>
  <int value="2" label="PreLibraryLoaderInit"/>
  <int value="3" label="PostLibraryLoaderInit"/>
  <int value="4" label="PreStarboardBridgeInit"/>
  <int value="5" label="StarboardBridgeNativeInit"/>
  <int value="6" label="ApplicationAndroidInitialize"/>
  <int value="7" label="PostStarboardBridgeInit"/>
  <int value="8" label="ActivityWindowConfigured"/>
  <int value="9" label="PostActivityOnCreate"/>
  <int value="10" label="PreActivityOnStart"/>
  <int value="11" label="PostActivityOnStart"/>
  <int value="12" label="PreActivityOnResume"/>
  <int value="13" label="PostActivityOnResume"/>
  <int value="14" label="MainDelegateBasicStartupComplete"/>
  <int value="15" label="MainDelegatePreSandboxStartup"/>
  <int value="16" label="MainDelegatePostEarlyInitialization"/>
  <int value="17" label="PreCreateThreads"/>
  <int value="18" label="ShellCreateWindowNoSplash"/>
  <int value="19" label="ShellCreateWindowWithSplash"/>
  <int value="20" label="ShellRenderFrameCreated"/>
  <int value="21" label="ShellDidStartLoading"/>
  <int value="22" label="DidStartNavigation"/>
  <int value="23" label="SplashObserverDidStartNavigation"/>
  <int value="24" label="SplashObserverDidStartLoading"/>
  <int value="25" label="SplashObserverDidFailLoad"/>
  <int value="26" label="DidFinishNavigation"/>
  <int value="27" label="ShellDocumentElementAvailable"/>
  <int value="28" label="SplashObserverDidFinishNavigation"/>
  <int value="29" label="ShellDidStartNavigationNonSplash"/>
  <int value="30" label="ShellDidFinishNavigationNonSplash"/>
  <int value="31" label="ShellDidFinishLoad"/>
  <int value="32" label="StartupGuardObserverDidStartLoading"/>
  <int value="33" label="StartupGuardObserverDidStartNavigation"/>
  <int value="34" label="StartupGuardObserverDidFailLoad"/>
  <int value="35" label="StartupGuardObserverDidFinishNavigation"/>
  <int value="36" label="StartupGuardObserverDidRedirectNavigation"/>
  <int value="37" label="PlatformErrorRaised"/>
</enum>

<enum name="FinchConfigOutcome">
  <int value="0" label="Regular config loaded"/>
  <int value="1" label="Safe config loaded"/>
  <int value="2" label="Empty config loaded due to crash streak"/>
  <int value="3" label="Empty config loaded due to expiration"/>
  <int value="4" label="Empty config loaded due to rollback"/>
</enum>

<enum name="GpuMemoryAblationResult">
  <int value="0" label="Success"/>
  <int value="1" label="GL Out Of Memory"/>
  <int value="2" label="Exceeds Max Limit"/>
  <int value="3" label="GpuChannelManager Unavailable"/>
  <int value="4" label="SharedContextState Unavailable"/>
  <int value="5" label="Context Lost"/>
  <int value="6" label="MakeCurrent Failed"/>
  <int value="7" label="GL API Unavailable"/>
  <int value="8" label="Other GL Error"/>
</enum>

<enum name="LocalStorageDatabaseResetReason">
  <int value="0" label="Failure to open the database"/>
  <int value="1" label="Schema version mismatch"/>
  <int value="2" label="Database corruption or read errors"/>
  <int value="3" label="Excessive commit errors"/>
  <int value="4" label="Unknown"/>
</enum>

<!-- LINT.IfChange(LocalStorageRecoveryEvent) -->

<enum name="LocalStorageRecoveryEvent">
  <int value="0" label="Repaired missing CURRENT file"/>
  <int value="1" label="Failed to repair missing CURRENT file"/>
  <int value="2" label="Repaired open corruption"/>
  <int value="3" label="Failed to repair open corruption"/>
  <int value="4" label="Open fell back to volatile memory (disk full)"/>
  <int value="5" label="Open fell back to volatile memory (lock or I/O error)"/>
  <int value="6" label="Version read I/O error fell back to volatile memory"/>
  <int value="7" label="Reopened database in place after commit I/O errors"/>
  <int value="8"
      label="Failed to reopen database in place after commit I/O errors"/>
</enum>

<!-- LINT.ThenChange(//components/services/storage/dom_storage/dom_storage_database.h:LocalStorageRecoveryEvent) -->

<enum name="MigrationOutcome">
  <int value="0" label="FastPath"/>
  <int value="1" label="Skipped"/>
  <int value="2" label="Success"/>
  <int value="3" label="Failed"/>
  <int value="4" label="Timeout"/>
</enum>

<enum name="NativeMemoryAblationResult">
  <int value="0" label="Success"/>
  <int value="1" label="Allocation Failed (OOM)"/>
  <int value="2" label="Exceeds Max Limit"/>
</enum>

<enum name="PlatformServiceSendStatus">
  <int value="0" label="Success"/>
  <int value="1" label="Message too large"/>
  <int value="2" label="Extension not implemented"/>
  <int value="3" label="Invalid service handle"/>
  <int value="4" label="Starboard invalid state"/>
  <int value="5" label="Null response data"/>
</enum>

<enum name="SentinelWriteResult">
  <int value="0" label="Success"/>
  <int value="1" label="Empty Path"/>
  <int value="2" label="Write Failed"/>
</enum>

<enum name="SlotSelectionStatus">
  <summary>Possible status of slot selection by the Loader App.</summary>
  <int value="0" label="Unknown"/>
  <int value="1" label="Current slot"/>
  <int value="2" label="Roll forward"/>
  <int value="3" label="Roll back: Out of retries"/>
  <int value="4" label="Roll back: No library file"/>
  <int value="5" label="Roll back: Bad app key file"/>
  <int value="6" label="Roll back: Slot draining"/>
  <int value="7" label="Roll back: Failed to adopt"/>
  <int value="8" label="Roll back: Failed to load Cobalt"/>
  <int value="9" label="Roll back: Failed to check SABI"/>
  <int value="10" label="Roll back: Failed to look up symbols"/>
  <int value="11" label="Evergreen Lite"/>
  <int value="12"
      label="Load system image: Failed to initialize installation manager"/>
</enum>

<enum name="SmapsReliability">
  <int value="0" label="Success"/>
  <int value="1" label="Rollup missing"/>
  <int value="2" label="Access denied"/>
  <int value="3" label="Unreliable"/>
</enum>

<enum name="SplashCacheClearResult">
  <int value="0" label="No cached files"/>
  <int value="1" label="Cleared"/>
  <int value="2" label="Failed"/>
</enum>

<enum name="SplashScreenFetchedState">
  <int value="0" label="Success: Content from builtin"/>
  <int value="1" label="Success: Content from cache"/>
  <int value="2"
      label="Error: content from cache is empty, fallback to builtin."/>
  <int value="3"
      label="Error: Content from cache is too large, fallback to builtin."/>
  <int value="4" label="Error: Failed to read cache, fallback to builtin."/>
  <int value="5" label="Error: Builtin resource not found."/>
  <int value="6" label="Skipped: cached assets disabled"/>
</enum>

<enum name="StorageInjectionResult">
  <int value="0" label="Success"/>
  <int value="1" label="Error"/>
  <int value="2" label="Timeout"/>
</enum>

<enum name="StorageReadResult">
  <int value="0" label="Success"/>
  <int value="1" label="Partition key not default"/>
  <int value="2" label="Record invalid"/>
  <int value="3" label="Size too small"/>
  <int value="4" label="Delete failed"/>
  <int value="5" label="Read mismatch"/>
  <int value="6" label="Header mismatch"/>
  <int value="7" label="Parse error"/>
</enum>

<enum name="VariationsConfigState">
  <int value="0" label="Config is valid"/>
  <int value="1" label="Config is expired"/>
  <int value="2" label="Config is missing timestamp"/>
</enum>

</enums>

</histogram-configuration>
