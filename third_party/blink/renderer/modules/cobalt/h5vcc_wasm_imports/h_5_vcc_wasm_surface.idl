// Video surfaces: where a player's punch-out video is shown. See
// h_5_vcc_wasm_imports.idl.
[
    Exposed=(Window,DedicatedWorker),
    RuntimeEnabled=H5vccWasmImports,
    SecureContext
]
interface H5vccWasmSurface {
  // Returns a surface handle, or 0 on failure.
  [NoAllocDirectCall] unsigned long create(unsigned long flags);
  [NoAllocDirectCall] undefined destroy(unsigned long surface);

  // Positions the surface in screen pixels, for surfaces not bound to an
  // element.
  [NoAllocDirectCall]
  undefined setBounds(unsigned long surface,
                      long x,
                      long y,
                      long width,
                      long height,
                      long zIndex);

  // A <video> whose src is a blob: URL ending in `#sb-surface=<token>` shows
  // the surface at the element's position. Returns "" for unknown surfaces.
  DOMString token(unsigned long surface);
};
