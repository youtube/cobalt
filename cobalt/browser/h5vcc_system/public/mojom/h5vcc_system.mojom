module h5vcc_system.mojom;

enum UserOnExitStrategy {
  kClose,
  kMinimize,
  kNoExit,
};

enum LowMemoryKillForegroundStatus {
  kForeground,
  kBackground,
};

enum LowMemoryKillPressureSource {
  kSystem,
  kCobalt,
};

struct LowMemoryKillDetails {
  int64 timestamp_posix_usec;
  LowMemoryKillForegroundStatus? foreground_status;
  LowMemoryKillPressureSource? pressure_source;
  uint64? system_memory_available;
  uint64? system_memory_total;
  uint64? cobalt_memory_usage;
  uint64? cobalt_memory_limit;
  string? reason;
};

// The browser process must provide an implementation of this interface so that
// the renderer process can implement the H5vccSystem Blink API.
interface H5vccSystem {
  // Get the advertisingId for the device.
  GetAdvertisingId() => (string advertising_id);
  [Sync]
  GetAdvertisingIdSync() => (string advertising_id);
  // Get the limitAdTracking for the device.
  GetLimitAdTracking() => (bool limitAdTracking);
  [Sync]
  GetLimitAdTrackingSync() => (bool limitAdTracking);
  GetTrackingAuthorizationStatus() => (string tracking_authorization_status);
  [Sync]
  GetTrackingAuthorizationStatusSync() => (string tracking_authorization_status);
  RequestTrackingAuthorization() => (bool is_tracking_authorization_supported);

  // Gets the friendly name of the device from the platform.
  GetFriendlyName() => (string friendly_name);

  // Gets the physical screen diagonal in inches from the platform (0.0 if unknown).
  GetScreenDiagonal() => (double diagonal);

  // Returns the platform-specific user on exit strategy.
  [Sync]
  GetUserOnExitStrategy() => (UserOnExitStrategy userOnExitStrategy);
  // Platform-specific conceal or stop depending on strategy.
  Exit();

  // YouTube request to hide the splash screen.
  HideSplashScreen();

  // Resolves to true/false if the platform supports LowMemoryKill v1, or null
  // if the platform does not implement the LowMemoryKill extension.
  GetWasLowMemoryKilled() => (bool? was_low_memory_killed);

  // If the platform provides LowMemoryKill v2 details, resolves with
  // `supported` true and `details` populated if the previous Cobalt session was
  // killed by the system due to memory pressure (or null if not). Otherwise
  // resolves with `supported` false and `details` null.
  GetLowMemoryKillDetails() => (bool supported, LowMemoryKillDetails? details);
};
