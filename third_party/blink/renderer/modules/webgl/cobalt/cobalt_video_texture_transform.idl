// Cobalt Android WebGL extension that exposes the decode-to-texture
// crop transform (scale + offset) for the current video frame so shaders
// sampling an OES_EGL_image_external surface can avoid bleeding decoder
// alignment padding.
//
// This extension is currently specific to Android/AndroidTV platforms, where
// MediaCodec hardware decoders allocate buffer storage aligned to macroblock
// boundaries and expose the raw surface via GL_TEXTURE_EXTERNAL_OES without
// automatic hardware cropping.
// See cobalt_video_texture_transform.h for details.

[
    LegacyNoInterfaceObject
] interface CobaltVideoTextureTransform {
    // Returns [scaleX, scaleY, offsetX, offsetY] when a valid video frame is
    // bound, or an empty sequence [] when uninitialized. Identity is [1, 1, 0, 0].
    sequence<float> getCurrentFrameTextureTransform(HTMLVideoElement? video);
};
