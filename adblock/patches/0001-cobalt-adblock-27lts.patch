+      if (isObject(secondary) && Array.isArray(secondary.sections)) {
+        for (var i = 0; i < secondary.sections.length; i++) {
+          var section = secondary.sections[i] && secondary.sections[i].tvSecondaryNavSectionRenderer;
+          if (!isObject(section) || !Array.isArray(section.tabs)) {
+            continue;
+          }
+          for (var j = 0; j < section.tabs.length; j++) {
+            var tab = section.tabs[j] && section.tabs[j].tabRenderer;
+            var tabSurface = tab && tab.content && tab.content.tvSurfaceContentRenderer;
+            var tabContent = tabSurface && tabSurface.content;
+            if (!isObject(tabContent)) {
+              continue;
+            }
+            stripSectionList(tabContent.sectionListRenderer);
+            if (isObject(tabContent.gridRenderer)) {
+              tabContent.gridRenderer.items = withoutAdItems(tabContent.gridRenderer.items);
+            }
+          }
+        }
+      }
+    }
+
+    var watchNext = response.contents.singleColumnWatchNextResults;
+    if (isObject(watchNext) && isObject(watchNext.pivot)) {
+      stripSectionList(watchNext.pivot.sectionListRenderer);
+    }
+
+    var continuation = response.continuationContents;
+    if (isObject(continuation)) {
+      stripSectionList(continuation.sectionListContinuation);
+      stripSectionList(continuation.horizontalListContinuation);
+      if (isObject(continuation.horizontalListContinuation)) {
+        continuation.horizontalListContinuation.items =
+          withoutAdItems(continuation.horizontalListContinuation.items);
+      }
+      if (isObject(continuation.gridContinuation)) {
+        continuation.gridContinuation.items = withoutAdItems(continuation.gridContinuation.items);
+      }
+    }
+  }
+
+  function stripEntries(holder) {
+    if (!isObject(holder) || !Array.isArray(holder.entries)) {
+      return;
+    }
+    var kept = [];
+    for (var i = 0; i < holder.entries.length; i++) {
+      var entry = holder.entries[i];
+      var command = entry && entry.command;
+      var endpoint = command && command.reelWatchEndpoint;
+      if (endpoint && endpoint.adClientParams && endpoint.adClientParams.isAd) {
+        continue;
+      }
+      kept.push(entry);
+    }
+    holder.entries = kept;
+  }
+
+  function stripShortsAds(response) {
+    stripEntries(response);
+    stripEntries(response.reelWatchFeedResponse);
+    stripEntries(response.reelWatchSequenceResponse);
+  }
+
+  function strip(response) {
+    if (!isObject(response)) {
+      return response;
+    }
+    stripAdKeys(response);
+    stripShortsAds(response);
+    try {
+      stripBrowseResponse(response);
+    } catch (e) {
+      /* unexpected response shape: keep the ad-key stripping only */
+    }
+    return response;
+  }
+
+  var originalParse = JSON.parse;
+  try {
+    JSON.parse = function () {
+      var parsed = originalParse.apply(this, arguments);
+      try {
+        strip(parsed);
+      } catch (e) {
+        /* never break the app's own parsing */
+      }
+      return parsed;
+    };
+  } catch (e) {
+    /* JSON.parse not writable: nothing else we can do */
+  }
+
+  var INNERTUBE_PATHS = [
+    "/youtubei/v1/player",
+    "/youtubei/v1/next",
+    "/youtubei/v1/browse",
+    "/youtubei/v1/search",
+    "/youtubei/v1/reel/",
+    "/get_midroll_info"
+  ];
+
+  function isInnerTubeUrl(url) {
+    var text = String(url || "");
+    for (var i = 0; i < INNERTUBE_PATHS.length; i++) {
+      if (text.indexOf(INNERTUBE_PATHS[i]) !== -1) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  try {
+    var originalFetch = window.fetch;
+    if (typeof originalFetch === "function" && typeof Response === "function") {
+      window.fetch = function () {
+        var args = arguments;
+        var requestUrl = "";
+        try {
+          requestUrl = args[0] && args[0].url ? args[0].url : args[0];
+        } catch (e) {
+          /* ignore */
+        }
+        return originalFetch.apply(this, args).then(function (response) {
+          if (!response || !response.clone) {
+            return response;
+          }
+          var responseUrl = String(response.url || requestUrl || "");
+          if (!isInnerTubeUrl(responseUrl)) {
+            return response;
+          }
+          return response
+            .clone()
+            .text()
+            .then(function (body) {
+              var parsed;
+              try {
+                parsed = originalParse(body);
+              } catch (e) {
+                return response;
+              }
+              try {
+                strip(parsed);
+              } catch (e) {
+                /* ignore */
+              }
+              var rebuilt;
+              try {
+                rebuilt = new Response(JSON.stringify(parsed), {
+                  status: response.status,
+                  statusText: response.statusText,
+                  headers: sanitizedHeaders(response.headers)
+                });
+              } catch (e) {
+                return response;
+              }
+              try {
+                Object.defineProperty(rebuilt, "url", {
+                  value: responseUrl,
+                  enumerable: true,
+                  configurable: true
+                });
+              } catch (e) {
+                /* Response may be non-extensible in older engines */
+              }
+              return rebuilt;
+            })
+            ["catch"](function () {
+              return response;
+            });
+        });
+      };
+    }
+  } catch (e) {
+    /* fetch is not available in this engine */
+  }
+
+  function stripJsonText(text) {
+    if (typeof text !== "string") {
+      return text;
+    }
+    var parsed = originalParse(text);
+    strip(parsed);
+    return JSON.stringify(parsed);
+  }
+
+  function stripXhrValue(value, xhr) {
+    if (typeof value === "string") {
+      return stripJsonText(value);
+    }
+    if (isObject(value) && xhr.responseType === "json") {
+      strip(value);
+    }
+    return value;
+  }
+
+  function shadowXhrProperty(xhr, name) {
+    var descriptor = Object.getOwnPropertyDescriptor(
+        XMLHttpRequest.prototype, name);
+    if (!descriptor || typeof descriptor.get !== "function") {
+      return;
+    }
+    var rawGet = descriptor.get;
+    var cached;
+    var hasCached = false;
+    try {
+      Object.defineProperty(xhr, name, {
+        configurable: true,
+        enumerable: true,
+        get: function () {
+          var value = rawGet.call(this);
+          if (hasCached) {
+            return cached;
+          }
+          try {
+            cached = stripXhrValue(value, this);
+            hasCached = true;
+            return cached;
+          } catch (e) {
+            return value;
+          }
+        }
+      });
+    } catch (e) {
+      /* not shadowable on this engine */
+    }
+  }
+
+  function installXhrHook() {
+    if (typeof XMLHttpRequest !== "function" || !XMLHttpRequest.prototype) {
+      return;
+    }
+    var proto = XMLHttpRequest.prototype;
+    var originalOpen = proto.open;
+    var originalSend = proto.send;
+    if (typeof originalOpen !== "function" || typeof originalSend !== "function") {
+      return;
+    }
+    proto.open = function (method, url) {
+      this.__ytTvAdblockUrl = String(url || "");
+      this.__ytTvAdblockHooked = false;
+      return originalOpen.apply(this, arguments);
+    };
+    proto.send = function () {
+      try {
+        if (!this.__ytTvAdblockHooked && isInnerTubeUrl(this.__ytTvAdblockUrl)) {
+          this.__ytTvAdblockHooked = true;
+          shadowXhrProperty(this, "responseText");
+          shadowXhrProperty(this, "response");
+        }
+      } catch (e) {
+        /* keep the request untouched */
+      }
+      return originalSend.apply(this, arguments);
+    };
+  }
+
+  try {
+    installXhrHook();
+  } catch (e) {
+    /* XMLHttpRequest not available in this engine */
+  }
+
+  try {
+    console.log("[yt-tv-adblock] active");
+  } catch (e) {
+    /* console is not forwarded on some Cobalt builds */
+  }
+})();
+)YTADBLOCK_JS";
+
+}  // namespace cobalt
+
+#endif  // COBALT_ADBLOCK_ADBLOCK_JS_H_
