// Clock, event queue and logging. See h_5_vcc_wasm_imports.idl.
[
    Exposed=(Window,DedicatedWorker),
    RuntimeEnabled=H5vccWasmImports,
    SecureContext
]
interface H5vccWasmSystem {
  // Monotonic time in microseconds.
  [NoAllocDirectCall] double nowUs();

  // Moves up to `count` queued sb_event records to `events`; returns how
  // many.
  [CallWith=Isolate, NoAllocDirectCall]
  unsigned long pollEvents(unsigned long events, unsigned long count);

  // Logs UTF-8 text with an sb_log_level.
  [CallWith=Isolate, NoAllocDirectCall]
  undefined log(unsigned long level,
                unsigned long message,
                unsigned long messageLength);
};
