import("//build/config/android/internal_rules.gni")
import("//build/config/android/rules.gni")
import("//cobalt/android/manifest.gni")
import("//starboard/content/fonts/variables.gni")
import("//starboard/content/ssl/certs.gni")
import("//third_party/icu/config.gni")

template("modular_apk") {
  _name = invoker.module_name
  _lib_name = invoker.lib_name
  _testonly = defined(invoker.testonly) && invoker.testonly

  if (_testonly) {
    _loader = "//starboard/elf_loader:elf_loader_sandbox"
  } else {
    _loader = "//starboard/loader_app"
  }

  if (_testonly) {
    _instrumentation_manifest_target =
        "${target_name}__instrumentation_manifest_resources"
    _instrumentation_manifest =
        "$target_gen_dir/$_instrumentation_manifest_target/AndroidManifest.xml"
    jinja_template("${_instrumentation_manifest_target}__generate") {
      testonly = true
      input =
          "//cobalt/aosp/apk/test/AndroidManifest_instrumentation.xml.jinja2"
      output = _instrumentation_manifest
      variables = [
        "evergreen_library=app/${_name}/lib/${_lib_name}.lz4",
        "evergreen_content=app/${_name}/content",
      ]
    }

    android_resources(_instrumentation_manifest_target) {
      testonly = true
      mergeable_android_manifests = [ _instrumentation_manifest ]
      deps = [ ":${_instrumentation_manifest_target}__generate" ]
    }
  }

  _assets_target = "${target_name}__assets"
  android_assets(_assets_target) {
    forward_variables_from(invoker, [ "testonly" ])
    disable_compression = true

    renaming_sources = [ "$root_build_dir/app/${_name}/lib/${_lib_name}.lz4" ]
    renaming_destinations = [ "app/${_name}/lib/${_lib_name}.lz4" ]

    # Cobalt Evergreen uses the empty font package.
    renaming_sources += [ "//starboard/content/fonts/config/empty/fonts.xml" ]
    renaming_destinations += [ "app/${_name}/content/fonts/fonts.xml" ]

    # The platform provides the fonts from cobalt_font_package.
    renaming_sources += [ "$root_build_dir/fonts/fonts.xml" ]
    renaming_destinations += [ "fonts/fonts.xml" ]
    foreach(_font, font_files) {
      _font_file = get_path_info(_font, "file")
      renaming_sources += [ "$root_build_dir/fonts/$_font_file" ]
      renaming_destinations += [ "fonts/$_font_file" ]
    }

    foreach(_cert, network_certs) {
      _cert_file = get_path_info(_cert, "file")
      renaming_sources += [ _cert ]
      renaming_destinations += [ "app/${_name}/content/ssl/certs/$_cert_file" ]
    }

    deps = [
      ":copy_${_name}_lib($default_toolchain)",
      "//starboard/content/fonts:copy_fonts($default_toolchain)",
      "//starboard/content/fonts:fonts_xml($default_toolchain)",
    ]

    if (icu_use_data_file) {
      renaming_sources += [ "//third_party/icu/cobalt/icudtl.dat" ]
      renaming_destinations += [ "app/${_name}/content/icudtl.dat" ]
    }

    if (!_testonly || _name == "cobalt_browsertests") {
      renaming_sources += [ "$root_build_dir/cobalt_shell.pak" ]
      renaming_destinations += [ "app/${_name}/content/cobalt_shell.pak" ]
      deps += [ "//cobalt/shell:pak($default_toolchain)" ]
    }
  }

  android_apk(target_name) {
    forward_variables_from(invoker, [ "testonly" ])
    apk_name = _name

    # Test apks are emitted at the Chromium native-test convention path
    # (<out>/<suite>_apk/<suite>-debug.apk) so build/android/test_runner.py
    # finds them. The suite is the `<name>_loader` target CI builds, so the
    # apk, deps archive and filter names all derive from that one target.
    if (_testonly) {
      create_apk_script = false
      final_apk_path =
          "$root_build_dir/${_name}_loader_apk/${_name}_loader-debug.apk"
    }

    android_manifest = cobalt_manifest
    android_manifest_dep = "//cobalt/android:cobalt_manifest"
    include_size_info = is_official_build

    deps = [
      ":$_assets_target",
      "//cobalt/aosp:cobalt_apk_java",
      "//cobalt/aosp:copy_libcpp_shared",
      "//components/crash/core/app:chrome_crashpad_handler_named_as_so($native_toolchain)",
    ]

    if (_testonly) {
      deps += [
        ":$_instrumentation_manifest_target",
        "//cobalt/aosp:test_instrumentation_java",
      ]
    }

    loadable_modules = [
      "$root_build_dir/libc++_shared.so",
      "$root_build_dir/native_target/libchrome_crashpad_handler.so",
    ]
    shared_libraries = [ _loader ]

    srcjar_deps =
        [ get_label_info(_loader, "label_no_toolchain") + "__jni_registration" ]
  }

  # For test apks, generate a bin/run_<name>_loader wrapper so upstream
  # build/android/test_runner.py can drive the suite (`--suite <name>_loader`).
  if (_testonly) {
    test_runner_script("${_name}_loader__test_runner_script") {
      apk_target = ":${_name}_apk"
      test_name = "${_name}_loader"
      test_suite = "${_name}_loader"
      test_type = "gtest"
    }
  }
}
